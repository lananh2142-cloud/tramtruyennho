---
import caiDat from '../data/cai-dat.json';
import { link, tatCaTheLoai, linkTheLoai } from '../lib/du-lieu';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import '../styles.css';

interface Props {
  tieuDe?: string;
  moTa?: string;
  anh?: string;
}
const { tieuDe, moTa = caiDat.moTa, anh } = Astro.props;
const tieuDeDayDu = tieuDe ? `${tieuDe} | ${caiDat.tenWeb}` : `${caiDat.tenWeb} – ${caiDat.khauHieu}`;
const urlTrang = new URL(Astro.url.pathname, Astro.site);
const urlAnh = anh ? new URL(anh, Astro.site).href : undefined;
const dsTheLoai = await tatCaTheLoai();
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDeDayDu}</title>
    <meta name="description" content={moTa} />
    <link rel="canonical" href={urlTrang} />
    <meta property="og:title" content={tieuDeDayDu} />
    <meta property="og:description" content={moTa} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlTrang} />
    {urlAnh && <meta property="og:image" content={urlAnh} />}
    <meta name="theme-color" content="#fbf7f2" />
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={link('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={caiDat.tenWeb} href={link('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        var g = localStorage.getItem('giao-dien');
        if (g) document.documentElement.dataset.theme = g;
        var r = document.documentElement;
        var c = localStorage.getItem('co-chu');
        if (c) r.style.setProperty('--co-chu', c + 'px');
        var gd = localStorage.getItem('gian-dong');
        if (gd) r.style.setProperty('--gian-dong', gd);
        var nd = localStorage.getItem('nen-doc');
        if (nd) r.dataset.nenDoc = nd;
        var pc = localStorage.getItem('phong-chu');
        if (pc) r.dataset.phongChu = pc;
      } catch (e) {}
    </script>
    {caiDat.thongKe.googleSearchConsole && <meta name="google-site-verification" content={caiDat.thongKe.googleSearchConsole} />}
    {caiDat.thongKe.googleAnalytics && (
      <>
        <!-- Google Analytics: đếm lượt đọc. Chỉ chủ web xem được số liệu tại analytics.google.com -->
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${caiDat.thongKe.googleAnalytics}`}></script>
        <script is:inline define:vars={{ gaId: caiDat.thongKe.googleAnalytics }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    {caiDat.quangCao.adsenseId && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${caiDat.quangCao.adsenseId}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <header class="dau-trang" id="dau-trang">
      <div class="khung hang-dau">
        <a class="logo" href={link('/')} aria-label={`${caiDat.tenWeb} – Trang chủ`}>
          <Logo co={40} />
          <span>{caiDat.tenWeb}</span>
        </a>
        <form class="o-tim-dau" action={link('/danh-sach/')} method="get" role="search">
          <Icon ten="tim-kiem" co={17} />
          <input name="q" type="search" placeholder="Tìm truyện, tác giả..." aria-label="Tìm truyện" />
        </form>
        <nav class="menu-chinh" id="menu-chinh" aria-label="Menu chính">
          {dsTheLoai.length > 0 && (
            <details class="menu-the-loai">
              <summary>Thể loại <Icon ten="xuong" co={15} /></summary>
              <div class="menu-tha">
                {dsTheLoai.map(({ ten, soTruyen }) => <a href={linkTheLoai(ten)}>{ten} <span>{soTruyen}</span></a>)}
              </div>
            </details>
          )}
          <a href={link('/danh-sach/')}>Danh sách</a>
          <a href={link('/hoan-thanh/')}>Hoàn thành</a>
          <a href={link('/tu-truyen/')}><Icon ten="danh-dau" co={16} /> Tủ truyện</a>
        </nav>
        <div class="nut-dau">
          {caiDat.ungHo.batTat && <a href={link('/ung-ho/')} class="nut nho nut-ung-ho"><Icon ten="ca-phe" co={16} /> <span>Ủng hộ</span></a>}
          <button id="doi-giao-dien" class="nut-tron" type="button" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối"><Icon ten="trang" co={17} /></button>
          <button id="nut-menu" class="nut-tron" type="button" aria-label="Mở menu" aria-expanded="false" aria-controls="menu-chinh"><Icon ten="menu" co={18} /></button>
        </div>
      </div>
    </header>
    <main class="khung">
      <slot />
    </main>
    <footer class="chan-trang">
      <div class="khung chan-luoi">
        <div class="chan-gioi-thieu">
          <a class="logo" href={link('/')}>
            <Logo co={40} />
            <span>{caiDat.tenWeb}</span>
          </a>
          <p>{caiDat.moTa}</p>
        </div>
        <div>
          <h2>Khám phá</h2>
          <ul>
            <li><a href={link('/danh-sach/')}>Danh sách truyện</a></li>
            <li><a href={link('/hoan-thanh/')}>Truyện hoàn thành</a></li>
            <li><a href={link('/tu-truyen/')}>Tủ truyện của bạn</a></li>
          </ul>
        </div>
        {dsTheLoai.length > 0 && (
          <div>
            <h2>Thể loại</h2>
            <ul>{dsTheLoai.slice(0, 6).map(({ ten }) => <li><a href={linkTheLoai(ten)}>{ten}</a></li>)}</ul>
          </div>
        )}
        <div>
          <h2>Thông tin</h2>
          <ul>
            <li><a href={link('/gioi-thieu/')}>Giới thiệu</a></li>
            {caiDat.ungHo.batTat && <li><a href={link('/ung-ho/')}>Ủng hộ tác giả</a></li>}
            <li><a href={link('/chinh-sach/')}>Chính sách bảo mật</a></li>
            <li><a href={link('/rss.xml')}>RSS</a></li>
            {caiDat.facebook && <li><a href={caiDat.facebook} rel="noopener" target="_blank">Facebook</a></li>}
          </ul>
        </div>
      </div>
      <div class="khung chan-cuoi">© {new Date().getFullYear()} {caiDat.tenWeb}. Mọi truyện trên trang đều thuộc bản quyền của tác giả.</div>
    </footer>
    <button id="len-dau" type="button" aria-label="Lên đầu trang" title="Lên đầu trang"><Icon ten="len" co={20} /></button>
    <script is:inline>
      // Nút lên đầu trang
      var lenDau = document.getElementById('len-dau');
      addEventListener('scroll', function () { lenDau.classList.toggle('hien', scrollY > 600); }, { passive: true });
      lenDau.addEventListener('click', function () { scrollTo({ top: 0, behavior: 'smooth' }); });
      // Menu trên điện thoại
      var nutMenu = document.getElementById('nut-menu');
      nutMenu.addEventListener('click', function () {
        var mo = document.getElementById('dau-trang').classList.toggle('mo-menu');
        nutMenu.setAttribute('aria-expanded', mo);
      });
      // Đóng menu thể loại khi bấm ra ngoài
      document.addEventListener('click', function (e) {
        document.querySelectorAll('details.menu-the-loai[open]').forEach(function (d) { if (!d.contains(e.target)) d.open = false; });
      });
      document.getElementById('doi-giao-dien').addEventListener('click', function () {
        var r = document.documentElement;
        var moi = r.dataset.theme === 'dark' ? 'light' : 'dark';
        r.dataset.theme = moi;
        try { localStorage.setItem('giao-dien', moi); } catch (e) {}
      });
    </script>
    <script>
      import { capNhatThoiGian } from '../scripts/tu-truyen';
      capNhatThoiGian();
    </script>
  </body>
</html>
