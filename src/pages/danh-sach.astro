---
import Khung from '../layouts/Khung.astro';
import OBia from '../components/OBia.astro';
import ThanhTheLoai from '../components/ThanhTheLoai.astro';
import { tomTatTatCa, khongDau } from '../lib/du-lieu';

const tatCa = await tomTatTatCa();
---
<Khung tieuDe="Danh sách truyện">
  <h1>Danh sách truyện</h1>
  <ThanhTheLoai />
  <div class="bo-loc">
    <input id="tim-kiem" class="o-tim" type="search" placeholder="Tìm tên truyện, tác giả..." aria-label="Tìm truyện" />
    <select id="loc-trang-thai" aria-label="Lọc trạng thái">
      <option value="">Mọi trạng thái</option>
      <option>Đang ra</option>
      <option>Hoàn thành</option>
      <option>Tạm dừng</option>
    </select>
    <select id="sap-xep" aria-label="Sắp xếp">
      <option value="moi">Mới cập nhật</option>
      <option value="ten">Tên A → Z</option>
      <option value="chuong">Nhiều chương nhất</option>
      <option value="dang">Mới đăng</option>
    </select>
  </div>
  <p class="loc-tam-trang" id="loc-tam-trang" hidden><span id="ten-tam-trang"></span> <a href="?">Bỏ lọc ✕</a></p>
  <p class="phu" id="dem-ket-qua"></p>
  <div class="luoi-bia" id="luoi">
    {tatCa.map((tt) => (
      <div
        data-tim={khongDau(`${tt.truyen.data.ten} ${tt.truyen.data.tacGia ?? ''} ${tt.truyen.data.theLoai.join(' ')}`).replace(/-/g, ' ')}
        data-trang-thai={tt.truyen.data.trangThai}
        data-ten={tt.truyen.data.ten}
        data-cap-nhat={tt.capNhat.valueOf()}
        data-dang={tt.truyen.data.ngayDang.valueOf()}
        data-chuong={tt.dsChuong.length}
        data-the-loai={tt.truyen.data.theLoai.join('|')}
      >
        <OBia tt={tt} />
      </div>
    ))}
  </div>
  <p id="khong-thay" class="trong" hidden>Không tìm thấy truyện nào phù hợp.</p>
  <script>
    import { DS_TAM_TRANG, hopTamTrang } from '../lib/tam-trang';
    const o = document.getElementById('tim-kiem') as HTMLInputElement;
    const tt = document.getElementById('loc-trang-thai') as HTMLSelectElement;
    const sx = document.getElementById('sap-xep') as HTMLSelectElement;
    const luoi = document.getElementById('luoi')!;
    const the = [...luoi.children] as HTMLElement[];
    const boDau = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

    // Nhận từ khoá từ ô tìm kiếm trên đầu trang (?q=...) và kiểu sắp xếp (?sap=...)
    const tham = new URLSearchParams(location.search);
    o.value = tham.get('q') ?? '';
    if (tham.get('sap')) sx.value = tham.get('sap')!;
    // Lọc theo tâm trạng khi bấm từ trang chủ (?tam-trang=...)
    const tamTrang = DS_TAM_TRANG.find((t) => t.ma === tham.get('tam-trang'));
    if (tamTrang) {
      document.getElementById('ten-tam-trang')!.textContent = `Truyện cho lúc bạn ${tamTrang.ten.charAt(0).toLowerCase() + tamTrang.ten.slice(1)}`;
      document.getElementById('loc-tam-trang')!.hidden = false;
    }

    const ap = () => {
      const q = boDau(o.value);
      let dem = 0;
      const sapXep = [...the].sort((a, b) => {
        switch (sx.value) {
          case 'ten': return a.dataset.ten!.localeCompare(b.dataset.ten!, 'vi');
          case 'chuong': return Number(b.dataset.chuong) - Number(a.dataset.chuong);
          case 'dang': return Number(b.dataset.dang) - Number(a.dataset.dang);
          default: return Number(b.dataset.capNhat) - Number(a.dataset.capNhat);
        }
      });
      for (const t of sapXep) {
        const hien = (!q || t.dataset.tim!.includes(q)) && (!tt.value || t.dataset.trangThai === tt.value)
          && (!tamTrang || hopTamTrang(tamTrang, t.dataset.theLoai!.split('|'), Number(t.dataset.chuong)));
        t.hidden = !hien;
        if (hien) dem++;
        luoi.appendChild(t);
      }
      document.getElementById('khong-thay')!.hidden = dem > 0;
      document.getElementById('dem-ket-qua')!.textContent = `${dem} truyện`;
    };
    [o, tt, sx].forEach((el) => el.addEventListener('input', ap));
    ap();
  </script>
</Khung>
