---
import Khung from '../../../layouts/Khung.astro';
import QuangCao from '../../../components/QuangCao.astro';
import BiaTruyen from '../../../components/BiaTruyen.astro';
import OBia from '../../../components/OBia.astro';
import { tomTatTatCa, linkChuong, linkTheLoai, link, anh, type TomTat } from '../../../lib/du-lieu';
import { kieuTheLoai } from '../../../lib/the-loai';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const tatCa = await tomTatTatCa();
  return tatCa.map((tt) => {
    // Truyện cùng thể loại: có chung nhiều thể loại nhất
    const cungLoai = tatCa
      .filter((x) => x.truyen.id !== tt.truyen.id)
      .map((x) => ({ x, diem: x.truyen.data.theLoai.filter((tl) => tt.truyen.data.theLoai.includes(tl)).length }))
      .filter(({ diem }) => diem > 0)
      .sort((a, b) => b.diem - a.diem || b.x.capNhat.valueOf() - a.x.capNhat.valueOf())
      .slice(0, 6)
      .map(({ x }) => x);
    return { params: { slug: tt.truyen.id }, props: { tt, cungLoai } };
  });
}

const { tt, cungLoai } = Astro.props as { tt: TomTat; cungLoai: TomTat[] };
const { truyen, dsChuong, chuongMoi, capNhat } = tt;
const d = truyen.data;
const { Content } = await render(truyen);
const MOI_TRANG = 50;
---
<Khung tieuDe={d.ten} moTa={d.gioiThieu} anh={anh(d.anhBia)}>
  <nav class="vet-dan" aria-label="Đường dẫn">
    <a href={link('/')}>Trang chủ</a> ›
    {d.theLoai[0] && <><a href={linkTheLoai(d.theLoai[0])}>{d.theLoai[0]}</a> ›</>}
    <span>{d.ten}</span>
  </nav>

  <article class="trang-truyen" data-slug={truyen.id}>
    <div class="dau-truyen" style={`--m1:${kieuTheLoai(d.theLoai[0]).mau[0]}`}>
      <BiaTruyen truyen={truyen} lon />
      <div class="tt-truyen">
        <h1>{d.ten}</h1>
        <dl class="bang-tt">
          {d.tacGia && <><dt>Tác giả</dt><dd>{d.tacGia}</dd></>}
          <dt>Thể loại</dt>
          <dd class="cac-the-loai">{d.theLoai.map((tl) => <a href={linkTheLoai(tl)}>{`${kieuTheLoai(tl).icon} ${tl}`}</a>)}</dd>
          <dt>Trạng thái</dt><dd><span class={`nhan ${d.trangThai === 'Hoàn thành' ? 'xong' : ''}`}>{d.trangThai}</span></dd>
          <dt>Số chương</dt><dd>{dsChuong.length}</dd>
          <dt>Cập nhật</dt><dd><time datetime={capNhat.toISOString()} data-tuong-doi>{capNhat.toLocaleDateString('vi-VN')}</time></dd>
        </dl>
        <div class="nut-hang">
          {dsChuong.length > 0 && <a class="nut chinh" id="nut-doc" href={linkChuong(truyen.id, dsChuong[0].data.so)}>📖 Đọc từ đầu</a>}
          {chuongMoi && dsChuong.length > 1 && <a class="nut" href={linkChuong(truyen.id, chuongMoi.data.so)}>Chương mới nhất</a>}
          <button class="nut" id="nut-luu" type="button" aria-pressed="false">♡ Lưu vào tủ</button>
        </div>
      </div>
    </div>

    <section class="gioi-thieu-truyen">
      <h2 class="tieu-de-muc">Giới thiệu</h2>
      <div class="noi-dung-gioi-thieu thu-gon" id="gioi-thieu">
        <p>{d.gioiThieu}</p>
        <Content />
      </div>
      <button class="nut-xem-them" id="xem-them" type="button" hidden>Xem thêm ▾</button>
    </section>

    <QuangCao />

    <section>
      <div class="dau-muc">
        <h2 class="tieu-de-muc">Danh sách chương <small>({dsChuong.length})</small></h2>
        {dsChuong.length > 1 && <button class="nut nho" id="dao-thu-tu" type="button">⇅ Mới nhất trước</button>}
      </div>
      {dsChuong.length === 0 ? <p>Truyện chưa có chương nào.</p> : (
        <>
          <ol class="ds-chuong" id="ds-chuong" data-moi-trang={MOI_TRANG}>
            {dsChuong.map((c, i) => (
              <li hidden={i >= MOI_TRANG}>
                <a href={linkChuong(truyen.id, c.data.so)}>Chương {c.data.so}: {c.data.ten}</a>
                <time datetime={c.data.ngayDang.toISOString()}>{c.data.ngayDang.toLocaleDateString('vi-VN')}</time>
              </li>
            ))}
          </ol>
          {dsChuong.length > MOI_TRANG && <nav class="phan-trang" id="phan-trang" aria-label="Trang danh sách chương"></nav>}
        </>
      )}
    </section>

    {cungLoai.length > 0 && (
      <section>
        <h2 class="tieu-de-muc">Truyện cùng thể loại</h2>
        <div class="luoi-bia">{cungLoai.map((x) => <OBia tt={x} />)}</div>
      </section>
    )}
  </article>

  <script>
    import { lichSu, daLuu, doiLuu } from '../../../scripts/tu-truyen';
    const slug = document.querySelector<HTMLElement>('.trang-truyen')!.dataset.slug!;

    // Nút "Đọc tiếp" nếu đã đọc dở
    const dd = lichSu()[slug];
    const nutDoc = document.getElementById('nut-doc') as HTMLAnchorElement | null;
    if (dd && nutDoc) {
      nutDoc.href = nutDoc.href.replace(/chuong-\d+\/$/, `chuong-${dd.so}/`);
      nutDoc.textContent = `📖 Đọc tiếp chương ${dd.so}`;
    }

    // Lưu vào tủ truyện
    const nutLuu = document.getElementById('nut-luu')!;
    const veNutLuu = (luu: boolean) => {
      nutLuu.textContent = luu ? '♥ Đã lưu' : '♡ Lưu vào tủ';
      nutLuu.classList.toggle('da-luu', luu);
      nutLuu.setAttribute('aria-pressed', String(luu));
    };
    veNutLuu(daLuu().includes(slug));
    nutLuu.addEventListener('click', () => veNutLuu(doiLuu(slug)));

    // Giới thiệu dài thì thu gọn
    const gt = document.getElementById('gioi-thieu')!;
    const xemThem = document.getElementById('xem-them')!;
    if (gt.scrollHeight > gt.clientHeight + 10) xemThem.hidden = false;
    else gt.classList.remove('thu-gon');
    xemThem.addEventListener('click', () => {
      const gon = gt.classList.toggle('thu-gon');
      xemThem.textContent = gon ? 'Xem thêm ▾' : 'Thu gọn ▴';
    });

    // Danh sách chương: chia trang và đảo thứ tự
    const ds = document.getElementById('ds-chuong');
    if (ds) {
      const moiTrang = Number(ds.dataset.moiTrang);
      const phanTrang = document.getElementById('phan-trang');
      let trang = 0;
      const hien = () => {
        const muc = [...ds.children] as HTMLElement[];
        muc.forEach((li, i) => (li.hidden = Math.floor(i / moiTrang) !== trang));
        if (!phanTrang) return;
        const soTrang = Math.ceil(muc.length / moiTrang);
        phanTrang.innerHTML = '';
        for (let i = 0; i < soTrang; i++) {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = `${i * moiTrang + 1}–${Math.min((i + 1) * moiTrang, muc.length)}`;
          b.className = i === trang ? 'chon' : '';
          b.addEventListener('click', () => { trang = i; hien(); ds.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
          phanTrang.appendChild(b);
        }
      };
      hien();
      const nutDao = document.getElementById('dao-thu-tu');
      nutDao?.addEventListener('click', () => {
        [...ds.children].reverse().forEach((li) => ds.appendChild(li));
        ds.classList.toggle('dao');
        nutDao.textContent = ds.classList.contains('dao') ? '⇅ Cũ nhất trước' : '⇅ Mới nhất trước';
        trang = 0;
        hien();
      });
    }
  </script>
</Khung>
