---
import Khung from '../../layouts/Khung.astro';
import TheTruyen from '../../components/TheTruyen.astro';
import ThanhTheLoai from '../../components/ThanhTheLoai.astro';
import { tatCaTruyen, tatCaTheLoai, chuongCuaTruyen, khongDau } from '../../lib/du-lieu';

export async function getStaticPaths() {
  return (await tatCaTheLoai()).map(({ ten }) => ({ params: { theLoai: khongDau(ten) }, props: { ten } }));
}

const { ten } = Astro.props as { ten: string };
const dsTruyen = (await tatCaTruyen()).filter((t) => t.data.theLoai.includes(ten));
const soChuong = Object.fromEntries(await Promise.all(dsTruyen.map(async (t) => [t.id, (await chuongCuaTruyen(t.id)).length])));
---
<Khung tieuDe={`Truyện ${ten}`} moTa={`Đọc truyện ${ten} hay, cập nhật chương mới thường xuyên.`}>
  <h1>Truyện {ten}</h1>
  <ThanhTheLoai dangChon={ten} />
  <div class="luoi-truyen">
    {dsTruyen.map((t) => <TheTruyen truyen={t} soChuong={soChuong[t.id]} />)}
  </div>
</Khung>
