---
// Hình minh hoạ cho từng tâm trạng, cùng phong cách với Bé Sách (mặt cười, má hồng)
interface Props { ma: string; co?: number }
const { ma, co = 48 } = Astro.props;
---
<svg class="hinh-tam-trang" width={co} height={co} viewBox="0 0 48 48" aria-hidden="true">
  {ma === 'cuoi' && (
    <>
      <circle cx="24" cy="24" r="23" fill="#fff1cc" />
      <g stroke="#ffb72b" stroke-width="2.6" stroke-linecap="round">
        <path d="M24 5.5v4" /><path d="M24 40.5v3" /><path d="M5.5 25h4" /><path d="M38.5 25h4" />
        <path d="M11 11.5l2.8 2.8" /><path d="M34.2 35.2l2.6 2.6" /><path d="M37 11.5l-2.8 2.8" /><path d="M13.8 35.2l-2.6 2.6" />
      </g>
      <circle cx="24" cy="25" r="12.5" fill="#ffc93c" stroke="#eba51c" stroke-width="1.5" />
      <path d="M18.3 23.2q2-2.6 4 0M25.7 23.2q2-2.6 4 0" fill="none" stroke="#5a3a12" stroke-width="1.8" stroke-linecap="round" />
      <path d="M19.8 27.4q4.2 5.8 8.4 0z" fill="#e5594f" stroke="#5a3a12" stroke-width="1.3" stroke-linejoin="round" />
      <ellipse cx="16.6" cy="27.8" rx="2" ry="1.2" fill="#ff8a80" opacity=".75" />
      <ellipse cx="31.4" cy="27.8" rx="2" ry="1.2" fill="#ff8a80" opacity=".75" />
    </>
  )}
  {ma === 'khoc' && (
    <>
      <circle cx="24" cy="24" r="23" fill="#e1eaff" />
      <!-- Vẽ viền trước (to hơn một chút), rồi phủ phần trắng lên trên để viền đám mây liền mạch -->
      <g fill="#8aa6e0">
        <circle cx="17" cy="23" r="7.3" /><circle cx="25" cy="18.5" r="9.3" /><circle cx="32" cy="23.5" r="6.8" /><rect x="9.7" y="21.2" width="29.1" height="9.6" rx="4.8" />
      </g>
      <g fill="#ffffff">
        <circle cx="17" cy="23" r="6.5" /><circle cx="25" cy="18.5" r="8.5" /><circle cx="32" cy="23.5" r="6" /><rect x="10.5" y="22" width="27.5" height="8" rx="4" />
      </g>
      <circle cx="21" cy="24" r="1.4" fill="#3b4a6b" /><circle cx="28.5" cy="24" r="1.4" fill="#3b4a6b" />
      <path d="M22.8 28q2-1.6 4 0" fill="none" stroke="#3b4a6b" stroke-width="1.4" stroke-linecap="round" />
      <ellipse cx="18.2" cy="27" rx="1.7" ry="1" fill="#ffb3c1" /><ellipse cx="31.3" cy="27" rx="1.7" ry="1" fill="#ffb3c1" />
      <path d="M18 33.5q-2.4 3.4 0 5 2.4-1.6 0-5z" fill="#6fa8ff" />
      <path d="M25 35q-2 2.9 0 4.3 2-1.4 0-4.3z" fill="#8bbaff" />
      <path d="M31.5 33.5q-2.4 3.4 0 5 2.4-1.6 0-5z" fill="#6fa8ff" />
    </>
  )}
  {ma === 'hoi-hop' && (
    <>
      <circle cx="24" cy="24" r="23" fill="#ebe5ff" />
      <path d="M13.5 37V22a10.5 10.5 0 0 1 21 0v15l-3.5-2.6-3.5 2.6-3.5-2.6-3.5 2.6-3.5-2.6z" fill="#ffffff" stroke="#8b7bd8" stroke-width="1.6" stroke-linejoin="round" />
      <ellipse cx="20" cy="23" rx="2.1" ry="2.9" fill="#3b2f63" /><ellipse cx="28" cy="23" rx="2.1" ry="2.9" fill="#3b2f63" />
      <circle cx="20.7" cy="22" r=".8" fill="#fff" /><circle cx="28.7" cy="22" r=".8" fill="#fff" />
      <ellipse cx="24" cy="29.2" rx="1.6" ry="2" fill="#3b2f63" />
      <ellipse cx="16.8" cy="27.2" rx="1.9" ry="1.1" fill="#ffb3c8" /><ellipse cx="31.2" cy="27.2" rx="1.9" ry="1.1" fill="#ffb3c8" />
      <path d="M38 9.5v4M38 16.5v.5" stroke="#8b7bd8" stroke-width="2" stroke-linecap="round" />
    </>
  )}
  {ma === 'mo-mong' && (
    <>
      <circle cx="24" cy="24" r="23" fill="#ffe6f1" />
      <path d="M24 37C14.5 30.5 11 25.5 11 20.5a6.6 6.6 0 0 1 13-1.8 6.6 6.6 0 0 1 13 1.8c0 5-3.5 10-13 16.5z" fill="#ff93c2" stroke="#e2649d" stroke-width="1.4" stroke-linejoin="round" />
      <path d="M17.6 23q2 2 4 0M26.4 23q2 2 4 0" fill="none" stroke="#7a1f4a" stroke-width="1.6" stroke-linecap="round" />
      <path d="M22.6 27q1.4 1.4 2.8 0" fill="none" stroke="#7a1f4a" stroke-width="1.4" stroke-linecap="round" />
      <ellipse cx="16.4" cy="26.4" rx="1.8" ry="1.1" fill="#ffd0e3" /><ellipse cx="31.6" cy="26.4" rx="1.8" ry="1.1" fill="#ffd0e3" />
      <path d="M38 6.5l1.1 2.9 2.9 1.1-2.9 1.1L38 14.5l-1.1-2.9-2.9-1.1 2.9-1.1z" fill="#ffc83d" />
      <path d="M9.5 9l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z" fill="#ffc83d" />
      <circle cx="40" cy="20" r="1.2" fill="#ffc83d" />
    </>
  )}
  {ma === 'phieu-luu' && (
    <>
      <circle cx="24" cy="24" r="23" fill="#dbf3ec" />
      <ellipse cx="11" cy="37" rx="6" ry="2.6" fill="#ffffff" /><ellipse cx="38" cy="33" rx="4.5" ry="2" fill="#ffffff" />
      <path d="M24 7.5a11.5 11.5 0 0 1 11.5 11.5c0 6-6 9.8-8 13.8h-7c-2-4-8-7.8-8-13.8A11.5 11.5 0 0 1 24 7.5z" fill="#3fb59f" stroke="#2a8f7c" stroke-width="1.3" />
      <path d="M24 7.5c-4.3 4-5.6 10.5-3.5 25.3h7c2.1-14.8.8-21.3-3.5-25.3z" fill="#ffd36b" />
      <path d="M20.6 32.8l.6 4.2M27.4 32.8l-.6 4.2" stroke="#6b5a4a" stroke-width="1.2" stroke-linecap="round" />
