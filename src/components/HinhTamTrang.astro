      <circle cx="21.4" cy="19" r="1.2" fill="#5a3a12" /><circle cx="26.6" cy="19" r="1.2" fill="#5a3a12" />
      <path d="M22.6 22.2q1.4 1.3 2.8 0" fill="none" stroke="#5a3a12" stroke-width="1.2" stroke-linecap="round" />
    </>
  )}
  {ma === 'ngan' && (
    <>
      <circle cx="24" cy="24" r="23" fill="#e2e7fb" />
