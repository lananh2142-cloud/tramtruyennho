---
// Hộp đăng nhập / đăng ký (Google, Facebook, email + mật khẩu). Chỉ có khi đã kết nối Firebase.
import Logo from './Logo.astro';
import { link } from '../lib/du-lieu';
import cauHinh from '../data/firebase.json';
---
<dialog id="hop-dang-nhap" class="hop-dang-nhap" aria-labelledby="tieu-de-dang-nhap">
  <button type="button" class="dong-hop" data-dong aria-label="Đóng">✕</button>
  <div class="dau-hop">
    <Logo co={56} />
    <h2 id="tieu-de-dang-nhap">Chào mừng bạn đến Trạm</h2>
    <p>Đăng nhập để đồng bộ tủ truyện và bình luận cùng mọi người.</p>
  </div>

  <div class="nut-mxh">
    <button type="button" class="nut nut-google" data-dang-nhap="google">
      <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
      Tiếp tục với Google
    </button>
    {cauHinh.facebook && (
      <button type="button" class="nut nut-facebook" data-dang-nhap="facebook">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg>
        Tiếp tục với Facebook
      </button>
    )}
  </div>

  <div class="ngan-cach"><span>hoặc dùng email</span></div>

  <div class="the-hop" role="tablist">
    <button type="button" role="tab" class="chon" data-the="dang-nhap" aria-selected="true">Đăng nhập</button>
    <button type="button" role="tab" data-the="dang-ky" aria-selected="false">Tạo tài khoản</button>
  </div>

  <form class="form-hop" data-form="dang-nhap">
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
    <label>Mật khẩu<input type="password" name="matKhau" autocomplete="current-password" required minlength="6" /></label>
    <button type="submit" class="nut chinh">Đăng nhập</button>
    <button type="button" class="nut-chu" data-quen>Quên mật khẩu?</button>
  </form>

  <form class="form-hop" data-form="dang-ky" hidden>
    <label>Tên hiển thị<input type="text" name="ten" autocomplete="nickname" required maxlength="40" placeholder="Tên mọi người sẽ thấy khi bạn bình luận" /></label>
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
    <label>Mật khẩu<input type="password" name="matKhau" autocomplete="new-password" required minlength="6" placeholder="Ít nhất 6 ký tự" /></label>
    <label>Nhập lại mật khẩu<input type="password" name="matKhau2" autocomplete="new-password" required minlength="6" /></label>
    <button type="submit" class="nut chinh">Tạo tài khoản</button>
  </form>

  <p class="thong-bao-hop" role="status" aria-live="polite"></p>
  <p class="chu-nho-hop">Khi đăng nhập, bạn đồng ý với <a href={link('/chinh-sach/')}>Chính sách bảo mật</a> của Trạm.</p>
</dialog>
