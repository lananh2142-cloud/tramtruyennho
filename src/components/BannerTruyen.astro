---
// Banner truyện đề cử dạng xếp bìa: bìa giữa to nhất, các bìa khác xếp lớp hai bên; tự chuyển truyện
import BiaTruyen from './BiaTruyen.astro';
import { linkChuong, linkTruyen, type TomTat } from '../lib/du-lieu';
interface Props { ds: TomTat[] }
const { ds } = Astro.props;
// Vị trí ban đầu của từng bìa so với bìa giữa (cùng cách tính với đoạn mã chạy trên trình duyệt bên dưới)
const viTri = (i: number) => {
  let lech = i;
  if (lech > ds.length / 2) lech -= ds.length;
  return Math.abs(lech) <= 2 ? lech : 9;
};
---
<section class="banner-xoay" aria-roledescription="carousel" aria-label="Truyện đề cử">
  <div class="san-khau" id="san-khau">
    {ds.map(({ truyen }, i) => (
      <button type="button" class="the-xoay" data-chi-so={i} data-vt={viTri(i)}
        aria-label={`Xem truyện ${truyen.data.ten}`}>
        <BiaTruyen truyen={truyen} lon />
      </button>
    ))}
  </div>
  <div class="noi-dung-xoay">
    {ds.map(({ truyen, dsChuong }, i) => (
      <div class="tt-xoay" data-chi-so={i} hidden={i !== 0}>
        <h2><a href={linkTruyen(truyen.id)}>{truyen.data.ten}</a></h2>
        {truyen.data.tacGia && <p class="tac-gia-xoay">{truyen.data.tacGia}</p>}
        <p class="mo-ta-xoay">{truyen.data.gioiThieu}</p>
        <a class="nut-vien" href={dsChuong[0] ? linkChuong(truyen.id, dsChuong[0].data.so) : linkTruyen(truyen.id)}>Đọc Ngay</a>
      </div>
    ))}
    {ds.length > 1 && (
      <div class="cham-xoay" role="tablist" aria-label="Chọn truyện">
        {ds.map((_, i) => <button type="button" data-chi-so={i} class={i === 0 ? 'chon' : ''} aria-label={`Truyện thứ ${i + 1}`}></button>)}
      </div>
    )}
  </div>
</section>

<script>
  const banner = document.querySelector<HTMLElement>('.banner-xoay');
  if (banner) {
    const sanKhau = banner.querySelector<HTMLElement>('.san-khau')!;
    const the = [...banner.querySelectorAll<HTMLElement>('.the-xoay')];
    const tt = [...banner.querySelectorAll<HTMLElement>('.tt-xoay')];
    const cham = [...banner.querySelectorAll<HTMLElement>('.cham-xoay button')];
    const n = the.length;
    let hienTai = 0;
    let keo = 0; // số bìa đang kéo lệch (có thể là số lẻ khi đang kéo dở)

    // Đặt từng bìa theo độ lệch so với bìa giữa: 0 là giữa, ±1 kế bên, ±2 xa hơn
    const ve = () => {
      const w = sanKhau.clientWidth;
      const S1 = w * 0.24, S2 = w * 0.41;
      the.forEach((t, j) => {
        let lech = j - hienTai + keo;
        while (lech > n / 2) lech -= n;
        while (lech < -n / 2) lech += n;
        const a = Math.abs(lech), dau = Math.sign(lech);
        const x = dau * (a <= 1 ? a * S1 : S1 + (a - 1) * (S2 - S1));
        const scale = a <= 1 ? 1 - a * 0.2 : Math.max(0.5, 0.8 - (a - 1) * 0.18);
        t.style.transform = `translate(calc(-50% + ${x}px), -50%) scale(${scale})`;
        t.style.filter = `brightness(${1 - Math.min(a, 2) * 0.15})`;
        t.style.opacity = a > 2.4 ? '0' : '1';
        t.style.zIndex = String(10 - Math.round(a * 2));
        t.style.pointerEvents = a > 2.4 ? 'none' : '';
      });
    };

    const chon = (i: number) => {
      hienTai = ((i % n) + n) % n;
      keo = 0;
      ve();
      tt.forEach((x, j) => (x.hidden = j !== hienTai));
      cham.forEach((c, j) => c.classList.toggle('chon', j === hienTai));
    };

    // Kéo bằng ngón tay hoặc chuột: bìa chạy theo, thả ra thì dừng ở bìa gần nhất
    let x0: number | null = null;
    let daKeo = false;
    sanKhau.addEventListener('pointerdown', (e) => {
      x0 = e.clientX;
      daKeo = false;
      sanKhau.classList.add('dang-keo');
    });
    sanKhau.addEventListener('pointermove', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (!daKeo && Math.abs(dx) > 6) { daKeo = true; sanKhau.setPointerCapture(e.pointerId); }
      if (daKeo) { keo = dx / (sanKhau.clientWidth * 0.24); ve(); }
    });
    const tha = () => {
      if (x0 === null) return;
      x0 = null;
      sanKhau.classList.remove('dang-keo');
      if (daKeo) chon(hienTai - Math.round(keo));
    };
    sanKhau.addEventListener('pointerup', tha);
    sanKhau.addEventListener('pointercancel', tha);

    // Bấm (không kéo): bìa bên cạnh thì chuyển tới, bìa giữa thì mở truyện
    the.forEach((t) => t.addEventListener('click', (e) => {
      if (daKeo) { e.preventDefault(); daKeo = false; return; }
      const i = Number(t.dataset.chiSo);
      if (i === hienTai) location.href = tt[i].querySelector<HTMLAnchorElement>('h2 a')!.href;
      else chon(i);
    }));
    cham.forEach((c) => c.addEventListener('click', () => chon(Number(c.dataset.chiSo))));
    addEventListener('resize', ve);
    chon(0);

    // Tự chuyển truyện; dừng khi người đọc đang rê chuột, đang kéo, hoặc máy tắt hiệu ứng chuyển động
    if (n > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let dung = false;
      banner.addEventListener('mouseenter', () => (dung = true));
      banner.addEventListener('mouseleave', () => (dung = false));
      setInterval(() => { if (!dung && x0 === null && !document.hidden) chon(hienTai + 1); }, 6000);
    }
  }
</script>
