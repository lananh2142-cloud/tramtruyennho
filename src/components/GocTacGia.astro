---
// Góc tác giả: giới thiệu tác giả và lời chào. Ẩn nếu chưa điền trong Cài đặt web
import caiDat from '../data/cai-dat.json';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { anh } from '../lib/du-lieu';
const g = caiDat.gocTacGia;
const dongChao = (g.loiChao ?? '').split('\n').map((d) => d.trim()).filter(Boolean);
---
{(g.butDanh || g.loiChao) && (
  <section class="hop-phu goc-tac-gia">
    <h2><span class="huy-hieu-muc nho"><Icon ten="nguoi" co={14} /></span>Góc tác giả</h2>
    <div class="tac-gia-dau">
      {g.anhDaiDien ? <img class="anh-tac-gia" src={anh(g.anhDaiDien)} alt={g.butDanh} width="56" height="56" /> : <Logo co={56} />}
      <div>
        {g.butDanh && <strong>{g.butDanh}</strong>}
        <span>Tác giả của Trạm</span>
      </div>
    </div>
    {dongChao.length > 0 && (
      <div class="loi-chao">
        {dongChao.map((d, i) => <p class={i === 0 && dongChao.length > 1 ? 'dong-dau' : ''}>{d}</p>)}
      </div>
    )}
  </section>
)}
