---
// Ô bìa truyện dạng lưới (giống mục "Truyện hot" trên các web truyện)
import BiaTruyen from './BiaTruyen.astro';
import { linkTruyen, laMoi, type TomTat } from '../lib/du-lieu';
interface Props { tt: TomTat }
const { truyen, dsChuong, capNhat } = Astro.props.tt;
const d = truyen.data;
---
<a class="o-bia" href={linkTruyen(truyen.id)} title={d.ten}>
  <div class="o-bia-anh">
    <BiaTruyen truyen={truyen} />
    {d.trangThai === 'Hoàn thành' ? <span class="nhan-goc full">FULL</span> : laMoi(capNhat) && <span class="nhan-goc moi">MỚI</span>}
    <span class="so-chuong-goc">{dsChuong.length} chương</span>
  </div>
  <h3>{d.ten}</h3>
  {d.tacGia && <p class="tac-gia-nho">{d.tacGia}</p>}
</a>
