---
import BiaTruyen from './BiaTruyen.astro';
import { linkTruyen, type Truyen } from '../lib/du-lieu';
import { kieuTheLoai } from '../lib/the-loai';
interface Props { truyen: Truyen; soChuong: number; moi?: boolean }
const { truyen, soChuong, moi = false } = Astro.props;
const d = truyen.data;
---
<a class="the-truyen hien-dan" href={linkTruyen(truyen.id)}>
  {moi && <span class="huy-hieu-moi">MỚI</span>}
  <BiaTruyen truyen={truyen} />
  <div class="thong-tin">
    <h3>{d.ten}</h3>
    <p class="the-nho">
      {d.theLoai.slice(0, 2).map((tl) => <span class="the-loai-nho">{`${kieuTheLoai(tl).icon} ${tl}`}</span>)}
    </p>
    <p class="mo-ta">{d.gioiThieu}</p>
    <p class="phu"><span class={`nhan ${d.trangThai === 'Hoàn thành' ? 'xong' : ''}`}>{d.trangThai}</span> · {soChuong} chương</p>
  </div>
</a>
