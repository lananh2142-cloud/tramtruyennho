---
import { anh, linkTruyen, type Truyen } from '../lib/du-lieu';
interface Props { truyen: Truyen; soChuong: number }
const { truyen, soChuong } = Astro.props;
const d = truyen.data;
---
<a class="the-truyen" href={linkTruyen(truyen.id)}>
  <div class="bia">
    {d.anhBia ? <img src={anh(d.anhBia)} alt={`Bìa truyện ${d.ten}`} loading="lazy" /> : <span class="bia-chu">{d.ten}</span>}
  </div>
  <div class="thong-tin">
    <h3>{d.ten}</h3>
    <p class="mo-ta">{d.gioiThieu}</p>
    <p class="phu"><span class={`nhan ${d.trangThai === 'Hoàn thành' ? 'xong' : ''}`}>{d.trangThai}</span> · {soChuong} chương</p>
  </div>
</a>
